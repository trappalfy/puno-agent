# Vite only loads .env files from this app's own directory (unlike apps/web,
# which explicitly loads the shared root .env — see apps/web/next.config.ts).
# Copy this to apps/site/.env.local for local overrides.

# Where the product app (apps/web) is served — every CTA and pricing link on
# this marketing site points here. Not a secret: it ends up in the client
# bundle regardless (VITE_-prefixed vars always do), and it's just a URL.
VITE_APP_URL=http://localhost:3000

# In production this is set in the Vercel project `puno-agent-site`, not here,
# and it must point at the product's own hostname (https://app.puno.ink) — the
# `*.vercel.app` address stops serving the moment a custom domain is attached
# and returns 404, not a redirect. Vite inlines VITE_ vars at BUILD time, so
# changing it in the dashboard does nothing until the site is redeployed: the
# value lives inside the emitted assets/index-*.js. No trailing slash.
