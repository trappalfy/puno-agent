# Local Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://puno:puno@localhost:5432/puno

# Robinhood Chain network selection: "mainnet" | "testnet"
NETWORK=testnet

# apps/agent — never commit real values. Private key comes from env only, never stored in DB.
AGENT_PRIVATE_KEY=
DRY_RUN=true
# Only used by `db:seed`, to register one existing vault as an agent row. The
# worker itself does NOT read this: it ticks every live agent in the database
# (apps/agent/src/main.ts), and signs for all of them with AGENT_PRIVATE_KEY —
# whose address must equal the network's `serviceAgent`, or it refuses to start.
VAULT_ADDRESS=
# Override the network's default RPC (e.g. http://127.0.0.1:8545 for a local
# Anvil instance during development). Leave unset to use NETWORK's default.
RPC_URL=
# Optional tuning — see apps/agent/src/config.ts for defaults.
# TICK_INTERVAL_MS=15000
# Fraction of L2 decisions replayed through Haiku for the divergence report.
# Defaults to 0.1 — the replay is never billed, so it is pure cost. Set it to 1
# in development to see every decision compared.
# COMPARISON_SAMPLE_RATE=0.1
# CREDITS_POLL_INTERVAL_MS=10000

# Anthropic API (server-side only)
ANTHROPIC_API_KEY=

# contracts/ — testnet deployer only. Never commit a real value; never reuse
# an address that holds real funds. See contracts/script/DeployTestnet.s.sol.
DEPLOYER_PRIVATE_KEY=

# Where PunoCredits forwards payments. REQUIRED by DeployTestnet, and it must
# not be the deployer: a deposit paid by the treasury is a self-transfer, the
# balance delta is zero, and `deposit` reverts. With the deployer holding the
# whole mock PUNO supply and also receiving it, the billing path cannot be
# exercised at all. Any second address you control will do on testnet.
PUNO_TREASURY=

# Mainnet only, and strongly recommended: the address PunoCredits ownership is
# handed to at deploy time. Whoever owns it can move the treasury and therefore
# redirect every payment, so leaving that on a key in a .env file is the largest
# standing risk in the deployment. Ownable2Step, so nothing moves until this
# address calls acceptOwnership() itself — the deployer stays owner until then.
PUNO_OWNER=

# The deploying key's own address, public. Together with PUNO_OWNER above these
# are the only two expectations `pnpm --filter @puno/agent preflight` cannot read
# off the chain: nothing on-chain says which address is *ours*, so without this
# the treasury check can only report what treasury() returned and not whether it
# equals the key that deployed — and a treasury equal to the deployer makes its
# own deposits revert. Unset leaves that row a SKIP, which is not a pass.
#
# Derive it, do not type it:
#   cast wallet address --private-key $DEPLOYER_PRIVATE_KEY
# The 2026-08-13 incident was a clipboard hijacker substituting addresses on
# copy, so a hand-pasted address here is the exact shape of that mistake.
DEPLOYER_ADDRESS=

# Billing is on-chain: users top up a credit balance by sending PUNO to the
# PunoCredits contract, and apps/agent's watcher indexes CreditsPurchased to
# credit them. Contract addresses live in packages/shared/src/network/config.ts,
# not here — the only knob is how far back a cold watcher starts scanning.
# Leave unset to start from the current head.
CREDITS_WATCHER_START_BLOCK=
# 32-byte hex key for encrypting BYOK Anthropic keys at rest — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Signs wallet login session cookies (32+ chars). Deliberately separate from
# ENCRYPTION_KEY: rotating or leaking the cookie signer must not implicate the
# key that protects stored API keys. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
