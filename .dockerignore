# The first entry is the one that matters. The root .env holds
# DEPLOYER_PRIVATE_KEY, AGENT_PRIVATE_KEY, ENCRYPTION_KEY, SESSION_SECRET and
# the database password; an image layer keeps whatever it was built with, and
# `docker history` will hand it back long after the file was deleted. Secrets
# reach the worker through the platform's own store and never through a build.
.env
.env.*
!.env.example

node_modules
**/node_modules

.git
.github

# Build output. Both are regenerated by the platform and copying them in only
# risks a stale bundle shadowing a fresh source tree.
**/.next
**/dist
**/out

# Not runtime inputs for the worker. `contracts` in particular carries the
# Foundry cache and both git submodules, which dwarf the rest of the context.
contracts
apps/site/src
apps/site/public
apps/site/index.html
apps/web/src
apps/web/public

# Docs, scratch and editor state.
*.md
!apps/agent/README.md
.vscode
.idea
docker-compose.yml
